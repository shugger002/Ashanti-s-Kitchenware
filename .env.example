# Application
NODE_ENV=development
APP_URL=http://localhost:3000
APP_NAME=Ashanti's Kitchenware

# PostgreSQL (never expose to the browser).
# Local: on-box Postgres.
# Production (Vercel): Supabase transaction pooler URI, port 6543.
DATABASE_URL=postgres://ashantisa:changeme@127.0.0.1:5432/ashantisa
# Session/direct URI for npm run db:migrate and db:bootstrap against Supabase (port 5432).
DIRECT_URL=
DATABASE_SSL=false

# Session cookies
SESSION_SECRET=replace-with-at-least-32-random-bytes
SESSION_COOKIE_NAME=ak_session
CUSTOMER_SESSION_COOKIE_NAME=ak_customer_session
SESSION_TTL_DAYS=14

# First administrator (used only by scripts/bootstrap-admin.ts)
BOOTSTRAP_ADMIN_EMAIL=admin@ashantisakitchenware.com
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_NAME=Store Owner

# Object storage (S3-compatible). Leave empty to use local disk in development only.
# On Vercel, set these to Supabase Storage S3 credentials (required in production).
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_BASE_URL=
S3_FORCE_PATH_STYLE=true

# Payments. Hubtel (hosted card/MoMo/GHQR) and Moolre (MoMo prompt) are the live providers.
# Leave all keys empty to keep orders pending until staff record a verified payment.
HUBTEL_CLIENT_ID=
HUBTEL_CLIENT_SECRET=
HUBTEL_MERCHANT_ACCOUNT_NUMBER=
HUBTEL_CHECKOUT_URL=https://rmp.hubtel.com/merchantaccount/onlinecheckout/invoice/create
HUBTEL_WEBHOOK_SECRET=

MOOLRE_API_USER=
MOOLRE_API_PUBKEY=
MOOLRE_ACCOUNT_NUMBER=
MOOLRE_WEBHOOK_SECRET=

# Optional leftover Paystack keys are ignored unless Hubtel and Moolre are unset.
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
PAYSTACK_WEBHOOK_SECRET=

# Optional email (password reset and order notices are skipped when unset)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Optional analytics (never load without cookie consent)
ANALYTICS_MEASUREMENT_ID=
